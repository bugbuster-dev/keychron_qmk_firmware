// Keychron Q3 Max — STM32F401 platform for Renode
//
// Starts from the generic STM32F4 base and overrides flash/SRAM sizing
// for F401CC (256 KB flash, 64 KB SRAM). All peripherals the firmware
// touches at boot — RCC, GPIO A-D, EXTI, timers, SPI1, USART2 — are
// inherited from the base. Q3 Max-specific peripherals (LKBT51 stub,
// matrix injector) are attached in Phase 2.

using "platforms/cpus/stm32f4.repl"

// F401CC sizing overrides
flash:
    size: 0x00040000   // 256 KB

sram:
    size: 0x00010000   // 64 KB

// Remove RTC. Renode's STM32F4_RTC model crashes when the firmware
// writes 0 to DateRegister (year=month=day=0 is not a representable
// DateTime). The Q3 Max wireless code touches RTC for sleep
// timestamps; this is not required for v1.0 emulation. Detach it
// from the bus and re-mount the address range as plain memory so
// register reads/writes are silent.
rtc: @ none
fake_rtc: Memory.MappedMemory @ sysbus 0x40002800
    size: 0x400

// OTG FS device-mode peripheral. Python-scripted stub that handles
// W1C interrupt-status registers, per-EP TX FIFO capture, and
// drives a minimal enumeration sequence. See emulator/otg_fs/SURVEY.md
// for design.
//
// Mapped over the full OTG FS region (Global + Device + PWRCLK + FIFOs
// = 0x4000 bytes). Replaces the upstream stm32f4.repl USB:RESET tag
// which only covered 0x50000010..0x5000003F. NVIC IRQ 67 is reached
// from the script via self.GetMachine()["sysbus.nvic"].OnGPIO(67, ...)
// — PythonPeripheral has no GPIO outputs of its own.
//
// IronPython 2.7.12 syntax — no f-strings, no Python 3 typing.
// Script inlined (not filename:) because Renode resolves relative
// `filename:` against its install directory, not cwd; absolute paths
// hurt portability.
otg_fs: Python.PythonPeripheral @ sysbus 0x50000000
    size: 0x4000
    initable: true
    script: '''
if request.IsInit:
    regs = {}
    regs[0x010] = 0x80000000  # GRSTCTL: AHBIDL=1 (bus idle, reset complete)
    ep_in_buffers = [[], [], [], [], [], []]  # one TX queue per IN endpoint
    enum_phase = "idle"
    # W1C set: writes of 1 clear the bit in these regs.
    w1c = set([0x014])  # GINTSTS
    for ep in range(6):
        w1c.add(0x908 + 0x20 * ep)  # DIEPINT(N)
        w1c.add(0xB08 + 0x20 * ep)  # DOEPINT(N)
    self.Log(LogLevel.Info, "otg_fs: peripheral initialised")
elif request.IsRead:
    o = request.Offset
    request.Value = regs.get(o, 0)
    self.Log(LogLevel.Noisy, "otg_fs R 0x%04x -> 0x%08x" % (o, request.Value))
elif request.IsWrite:
    o = request.Offset
    v = request.Value
    if o == 0x010:
        # GRSTCTL: handle core/FIFO/RX reset bits. Bits that mean
        # "go do something" are CSRST(0), HSRST(1), FCRST(2),
        # RXFFLSH(4), TXFFLSH(5). All self-clear once the
        # reset action completes. We model "instant completion"
        # by clearing those bits immediately and asserting AHBIDL.
        regs[o] = 0x80000000  # AHBIDL=1; all reset bits cleared
        self.Log(LogLevel.Noisy, "otg_fs GRSTCTL self-clear (req=0x%08x)" % v)
    elif o in w1c:
        cur = regs.get(o, 0)
        regs[o] = cur & ~v
        self.Log(LogLevel.Noisy, "otg_fs W1C 0x%04x clr=0x%08x" % (o, v))
    elif 0x1000 <= o < 0x7000:
        ep = (o - 0x1000) // 0x1000
        if 0 <= ep < 6:
            ep_in_buffers[ep].append(v)
            self.Log(LogLevel.Noisy,
                     "otg_fs TX-FIFO%d <- 0x%08x (len %d)"
                     % (ep, v, len(ep_in_buffers[ep])))
    else:
        regs[o] = v
        self.Log(LogLevel.Noisy, "otg_fs W 0x%04x <- 0x%08x" % (o, v))
        if o == 0x804 and (v & 0x2) == 0 and enum_phase == "idle":
            # DCTL.SDIS=0 → soft connect. Enumeration starts.
            enum_phase = "connect_pending"
            self.Log(LogLevel.Info,
                     "otg_fs: soft-connect (DCTL.SDIS=0)")
        elif o == 0x008 and (v & 0x1) and enum_phase != "active":
            # GAHBCFG.GINTMSK=1 — firmware has completed usb_lld_start
            # and is enabling global interrupts. v1.0 shortcut: force
            # USBD1.state = USB_ACTIVE (4) and configuration = 1.
            # This bypasses the full bus-reset / SET_ADDRESS /
            # GET_DESCRIPTOR / SET_CONFIGURATION enumeration sequence
            # we would otherwise have to drive via NVIC IRQ injection,
            # which IronPython PythonPeripheral cannot easily schedule
            # autonomously. The firmware will think a host configured
            # it; HID reports will start flowing into the IN-EP TX
            # FIFOs, which our ep_in_buffers will capture for Phase 4.
            sb = self.GetMachine()["sysbus"]
            sb.WriteByte(0x20008BB4, 4)         # USBD1.state = USB_ACTIVE
            sb.WriteByte(0x20008BB4 + 0x4F, 1)  # USBD1.configuration = 1
            enum_phase = "active"
            self.Log(LogLevel.Info,
                     "otg_fs: forced USBD1.state = USB_ACTIVE (v1.0 shortcut)")
'''
